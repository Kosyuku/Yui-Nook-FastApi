@@ -0,0 +1,101 @@
+"""Local HTTP endpoint for calling tools on the connected device."""
+from __future__ import annotations
+
+import os
+import json
+from aiohttp import web
+
+from config.logger import setup_logging
+from core.device_registry import get_connection, list_device_ids
+from core.handle.serverTtsPlayHandle import play_text_via_server_tts
+from core.providers.tools.device_mcp import call_mcp_tool
+from core.utils.util import sanitize_tool_name
+
+TAG = __name__
+
+
+class DeviceCallHandler:
+    def __init__(self, config: dict):
+        self.config = config
+        self.logger = setup_logging()
+
+    def _expected_token(self) -> str:
+        return (
+            os.getenv("STACKCHAN_TOKEN", "").strip()
+            or str(self.config.get("stackchan_token", "")).strip()
+        )
+
+    def _check_auth(self, request: web.Request) -> None:
+        expected = self._expected_token()
+        if not expected:
+            raise web.HTTPServiceUnavailable(text="STACKCHAN_TOKEN is not configured")
+
+        authorization = request.headers.get("Authorization", "")
+        token = authorization[7:] if authorization.startswith("Bearer ") else ""
+        if token != expected:
+            raise web.HTTPUnauthorized(text="Unauthorized")
+
+    async def handle_health(self, request: web.Request):
+        devices = await list_device_ids()
+        return web.json_response(
+            {
+                "ok": True,
+                "devices": devices,
+                "token_configured": bool(self._expected_token()),
+            }
+        )
+
+    async def handle_call(self, request: web.Request):
+        self._check_auth(request)
+        try:
+            payload = await request.json()
+        except json.JSONDecodeError as exc:
+            raise web.HTTPBadRequest(text="Invalid JSON") from exc
+
+        tool = str(payload.get("tool") or "").strip()
+        if not tool:
+            raise web.HTTPBadRequest(text="Missing tool")
+
+        arguments = payload.get("arguments") or {}
+        if not isinstance(arguments, dict):
+            raise web.HTTPBadRequest(text="arguments must be an object")
+
+        device_id = payload.get("device_id")
+        conn = await get_connection(str(device_id).strip() if device_id else None)
+        if conn is None:
+            devices = await list_device_ids()
+            raise web.HTTPNotFound(
+                text=json.dumps(
+                    {"error": "device not online or ambiguous", "devices": devices},
+                    ensure_ascii=False,
+                )
+            )
+
+        tool_name = sanitize_tool_name(tool)
+        if tool_name == "self_audio_play_text":
+            try:
+                result = await play_text_via_server_tts(
+                    conn, str(arguments.get("text") or "")
+                )
+            except ValueError as exc:
+                raise web.HTTPBadRequest(text=str(exc)) from exc
+            except RuntimeError as exc:
+                raise web.HTTPConflict(text=str(exc)) from exc
+            except Exception as exc:
+                self.logger.bind(tag=TAG).error(f"Server TTS playback failed: {exc}")
+                raise web.HTTPBadGateway(text=str(exc)) from exc
+            return web.json_response(
+                {"ok": True, "device_id": conn.device_id, "result": result}
+            )
+
+        mcp_client = getattr(conn, "mcp_client", None)
+        if not mcp_client or not await mcp_client.is_ready():
+            raise web.HTTPConflict(text="device MCP is not ready")
+
+        try:
+            result = await call_mcp_tool(conn, mcp_client, tool_name, arguments)
+        except Exception as exc:
+            self.logger.bind(tag=TAG).error(f"Device tool call failed: {exc}")
+            raise web.HTTPBadGateway(text=str(exc)) from exc
+
+        return web.json_response({"ok": True, "device_id": conn.device_id, "result": result})
