diff --git a/main/xiaozhi-server/core/device_registry.py b/main/xiaozhi-server/core/device_registry.py
new file mode 100644
index 00000000..f4d482be
--- /dev/null
+++ b/main/xiaozhi-server/core/device_registry.py
@@ -0,0 +1,41 @@
+"""Track online device websocket connections for local control endpoints."""
+from __future__ import annotations
+
+import asyncio
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from core.connection import ConnectionHandler
+
+
+_connections: dict[str, "ConnectionHandler"] = {}
+_lock = asyncio.Lock()
+
+
+async def register_connection(device_id: str | None, conn: "ConnectionHandler") -> None:
+    if not device_id:
+        return
+    async with _lock:
+        _connections[device_id] = conn
+
+
+async def unregister_connection(device_id: str | None, conn: "ConnectionHandler") -> None:
+    if not device_id:
+        return
+    async with _lock:
+        if _connections.get(device_id) is conn:
+            _connections.pop(device_id, None)
+
+
+async def get_connection(device_id: str | None = None) -> "ConnectionHandler | None":
+    async with _lock:
+        if device_id:
+            return _connections.get(device_id)
+        if len(_connections) == 1:
+            return next(iter(_connections.values()))
+        return None
+
+
+async def list_device_ids() -> list[str]:
+    async with _lock:
+        return sorted(_connections.keys())
